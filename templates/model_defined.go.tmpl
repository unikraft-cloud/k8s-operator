{{define "model_defined" -}}
{{- /* Unused imports are pruned by goimports after generation. */ -}}
import (
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/apimachinery/pkg/runtime"
)

{{$schema := .Schema}}
{{$schemaName := .SchemaName}}
{{- if $schema.Description}}
// {{$schema.Description | replace "\n" "\n// "}}
{{- end}}
type {{$schemaName}} {{schemaToGoType $schema | replace "map[string]interface{}" "runtime.RawExtension" | replace "interface{}" "runtime.RawExtension" | replace "time.Time" "metav1.Time"}}
{{- end}}
